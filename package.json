{
  "name": "bible-church-media-system",
  "version": "0.1.0",
  "description": "Sistema de escritorio profesional y multimedia para iglesias pentecostales",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start.js",
    "serve:downloads": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/serve-downloads.js",
    "start:dev": "env -u ELECTRON_RUN_AS_NODE electron --no-sandbox --remote-debugging-port=9222 .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --test tests/unit/*.test.js",
    "test:all": "ELECTRON_RUN_AS_NODE=1 electron --test tests/unit/*.test.js tests/**/*.test.js"
  },
  "keywords": [
    "church",
    "media",
    "bible",
    "projection",
    "electron",
    "sqlite"
  ],
  "author": "BIBLE Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^33.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  }
}
