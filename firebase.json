{
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/remote/**",
        "destination": "/remote/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

